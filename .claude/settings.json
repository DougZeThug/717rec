{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck*)", "Bash(npm run lint*)", "Bash(npm run test*)", "Bash(npm run build*)", "Bash(npm run knip*)", "Bash(npm run dev*)", "Bash(npm run e2e)", "Bash(npm run e2e *)",
      "Bash(npm test*)", "Bash(npm ci*)", "Bash(npm outdated*)", "Bash(npm audit*)", "Bash(npx vitest *)", "Bash(npx playwright test*)", "Bash(npx playwright install*)", "Bash(npx tsc *)", "Bash(npx eslint *)",
      "Bash(node factory/bin/factory.mjs*)", "Bash(node factory/bin/shoot.mjs*)", "Bash(node tools/sync-codex-agents.mjs*)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)", "Bash(git branch*)", "Bash(git checkout*)", "Bash(git switch*)", "Bash(git add*)", "Bash(git commit*)", "Bash(git stash*)", "Bash(git fetch*)", "Bash(git worktree*)", "Bash(git push*)",
      "Bash(ls*)", "Bash(cd *)", "Bash(wc *)", "Bash(head *)", "Bash(tail *)", "Bash(node --test factory/spec/*.spec.mjs*)"
    ],
    "ask": [
      "Edit(.claude/settings.json)", "Edit(.claude/settings.local.json)", "Edit(.factory/config.json)", "Write(.claude/settings.json)", "Write(.factory/config.json)",
      "Edit(factory/hooks/**)", "Write(factory/hooks/**)", "Edit(factory/bin/lib.mjs)", "Write(factory/bin/lib.mjs)", "Edit(tools/**)", "Write(tools/**)",
      "Edit(package.json)", "Write(package.json)", "Edit(vite.config.*)", "Edit(vitest.config.*)", "Edit(playwright.config.*)",
      "Edit(.github/workflows/**)", "Write(.github/workflows/**)"
    ],
    "deny": [
      "Bash(* .env)", "Bash(* .env.*)", "Bash(* ./.env)", "Bash(* ./.env.*)",
      "Read(./.env)", "Read(./.env.*)", "Edit(./.env)", "Edit(./.env.*)", "Write(./.env)", "Write(./.env.*)",
      "Bash(gh pr merge*)", "Bash(git push --force *)", "Bash(git push -f *)", "Bash(git push * --force*)", "Bash(git push * -f)",
      "Bash(git push * main)", "Bash(git push * master)", "Bash(git push * HEAD:main)", "Bash(git push * HEAD:master)",
      "Bash(supabase db push*)", "Bash(supabase migration up*)", "Bash(supabase functions deploy*)", "Bash(wrangler deploy*)", "Bash(npm publish*)",
      "mcp__github__merge_pull_request", "mcp__github__delete_file", "mcp__github__enable_pr_auto_merge",
      "mcp__Supabase__apply_migration", "mcp__Supabase__execute_sql", "mcp__Supabase__merge_branch", "mcp__Supabase__reset_branch", "mcp__Supabase__delete_branch", "mcp__Supabase__create_edge_function_secret", "mcp__Supabase__deploy_edge_function", "mcp__Supabase__pause_project", "mcp__Supabase__restore_project",
      "mcp__Vercel__create_deployment", "mcp__Vercel__request_promote", "mcp__Vercel__request_rollback", "mcp__Vercel__assign_alias", "mcp__Vercel__create_project_env", "mcp__Vercel__edit_project_env",
      "mcp__Lovable__deploy_project", "mcp__Lovable__send_message"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/factory/hooks/guard.mjs\" || exit 2", "timeout": 20, "onFailure": "block" }]
      }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/factory/hooks/session-start.mjs\"", "timeout": 10 }] }
    ]
  }
}
